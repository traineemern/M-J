{
  "name": "mandj-water-wells",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/validate-production-content.ts && tsc -b && tsx scripts/validate-diorama-layout.ts && tsx scripts/validate-sample-switch.ts && vite build && tsx scripts/validate-production-samples.ts && tsx scripts/generate-sitemap.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc -b --noEmit",
    "check:content": "tsx scripts/check-content.ts",
    "test": "vitest run",
    "test:slow": "vitest run --testPathPattern=slow",
    "media": "node scripts/extract_poster.cjs",
    "lighthouse": "node scripts/measure_performance.cjs"
  },
  "dependencies": {
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@formkit/auto-animate": "0.10.2",
    "@hookform/resolvers": "3.10.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/three": "^0.187.0",
    "clsx": "2.1.1",
    "gsap": "^3.15.1",
    "lenis": "1.3.27",
    "lottie-react": "3.1.2",
    "lucide-react": "0.475.0",
    "motion": "^14.14.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "react-router-dom": "7.2.0",
    "tailwind-merge": "3.0.1",
    "three": "^0.187.0",
    "typed.js": "3.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@tailwindcss/vite": "4.0.9",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.13.4",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.20.1",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "ffmpeg-static": "^5.3.0",
    "globals": "15.15.0",
    "jsdom": "26.0.0",
    "prettier": "3.5.1",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "4.0.9",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "vite": "6.2.0",
    "vitest": "3.0.5"
  }
}
